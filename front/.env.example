# ==============================================================================
# Frontend Environment Configuration Template (Next.js 16)
# Copy this file to .env.local (or .env) and fill in your actual values.
# NEVER commit .env or .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# NextAuth Authentication Configuration
# Generate a secret: npx auth secret (or openssl rand -base64 32)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-a-secure-random-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3003

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# Must match backend Google OAuth Client ID/Secret
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# API Endpoints
# ------------------------------------------------------------------------------
# Client-side requests in the browser go to:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side calls inside Docker go directly to the backend service:
NEXT_INTERNAL_API_BASE_URL=http://mubadala-back:8000

# ------------------------------------------------------------------------------
# Shared Internal Secret
# MUST match INTERNAL_API_SECRET in back/.env
# Used for server-to-server token synchronization
# ------------------------------------------------------------------------------
INTERNAL_API_SECRET=generate-a-matching-internal-api-secret-shared-with-frontend

# ------------------------------------------------------------------------------
# Optional Settings
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_DEBUG=false
