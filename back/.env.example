# ==============================================================================
# Backend Environment Configuration Template (Django REST Framework)
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_DB=mubadala_db
POSTGRES_USER=mubadala_user
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password

DB_NAME=mubadala_db
DB_USER=mubadala_user
DB_PASSWORD=change_this_to_a_secure_postgres_password
DB_HOST=mubadala-db
DB_PORT=5432
DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# Security & Secret Keys
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(50))"
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-generate-a-secure-random-key-here-for-production
INTERNAL_API_SECRET=generate-a-matching-internal-api-secret-shared-with-frontend

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3003/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# Networking, Hosts & CORS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3003
ALLOWED_HOSTS=localhost,mubadala-back,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost:8000,http://localhost:3003
CORS_ALLOWED_ORIGINS=http://localhost:3003

# ------------------------------------------------------------------------------
# Cache Configuration (Optional)
# Leave empty to use local PostgreSQL DatabaseCache (recommended for dev)
# Set a redis:// URL for production Redis caching
# ------------------------------------------------------------------------------
REDIS_URL=
